  m_GameObject: {fileID: 432989690}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u042D\u0442\u043E \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0438\u0433\u0440\u044B,
    \u043E\u043D \u0438\u0437\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432
    \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
    \u043F\u043E\u0439\u043C\u0430\u043D\u043D\u044B\u0445 \u0438\u043D\u0433\u0440\u0438\u0434\u0438\u0435\u043D\u0442\u043E\u0432.\n\n\u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0435\u0441\u043B\u0438 \u043B\u043E\u0432\u0438\u0442\u044C \u0432\u0441\u0435\u0433\u0434\u0430
    \u043E\u0431\u044A\u0435\u043A\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 - \u0433\u043E\u0442\u043E\u0432\u043A\u0430
    \u0431\u0443\u0434\u0435\u0442 \u0432 \u043A\u0440\u0430\u0441\u043D\u043E\u0439
    \u0437\u043E\u043D\u0435!\n\n\u0427\u0442\u043E\u0431\u044B \u0445\u043E\u0440\u043E\u0448\u043E
    \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C, \u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
